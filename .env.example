# Copia este archivo como .env.local para desarrollo. Nunca subas el .env real.

# --- Cliente (Vite). La anon key de Supabase es pública por diseño; la seguridad la dan las políticas RLS.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key

# --- Servidor (solo en Vercel > Settings > Environment Variables)
ANTHROPIC_API_KEY=
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_ANON_KEY=tu-anon-key
# Correos (separados por coma) que pueden usar las funciones con Claude. Vacío = cualquier usuario con sesión.
ALLOWED_EMAILS=
# Opcionales
CLAUDE_MODEL_FAST=claude-haiku-5-5
CLAUDE_MODEL_PLAN=claude-sonnet-5-5
